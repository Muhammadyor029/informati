# Django Core
DJANGO_SECRET_KEY=replace-with-strong-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
POSTGRES_DB=nova_informatika
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set USE_SQLITE=true only for local testing without PostgreSQL
USE_SQLITE=false

# CORS & CSRF Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Media Storage ('local' or 's3')
STORAGE_BACKEND=local
MEDIA_ROOT=media
MEDIA_URL=/media/

# Curriculum Protection Code (checked server-side only)
CURRICULUM_UNLOCK_CODE=Samandar123
